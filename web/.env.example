# Study API (Backend :8000). Study-logic is mounted on this same /api/v1 prefix.
# Do not set this to Study-logic's standalone :3000 — that port is the Web UI.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Avoid CORS during local UI work: use a same-origin path and proxy to Backend.
# VITE_API_BASE_URL=/api/v1
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# UI-only smoke if the API is down. In-memory stand-in — not real study logic.
# VITE_USE_MOCK=1
