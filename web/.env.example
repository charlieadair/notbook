# Study API base URL, including the /api/v1 prefix when Backend serves it.
# Example when Backend listens on :8000:
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# If Study-logic is running alone (no /api/v1 prefix, default :3000):
# VITE_API_BASE_URL=http://127.0.0.1:3000

# Avoid CORS during local UI work: use a same-origin path and proxy to Backend.
# VITE_API_BASE_URL=/api/v1
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# UI-only smoke if the API is down. In-memory stand-in — not real study logic.
# VITE_USE_MOCK=1
