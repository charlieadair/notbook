# Copy to .env (never commit the real file). Default adapter is stub — no key required.

DATA_DIR=data
INFERENCE_PROVIDER=stub

# Aliases also accepted: NOTBOOK_DATA_DIR, INFERENCE_ADAPTER,
# OPENAI_EMBED_MODEL, OPENAI_CHAT_MODEL

# To use any OpenAI-compatible server (local runtime, proxy, or paid provider):
# INFERENCE_PROVIDER=openai-compatible
# OPENAI_API_BASE=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=sk-not-committed
# EMBED_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini
#
# Upload bounds (issue #35). OpenRouter :free embed/chat models can stall;
# these timeouts keep POST /sources from hanging forever.
# PDF_EXTRACT_TIMEOUT_SECONDS=30
# PDF_MAX_PAGES=200
# PDF_MAX_CHARS=500000
# INFERENCE_CONNECT_TIMEOUT_SECONDS=10
# INFERENCE_READ_TIMEOUT_SECONDS=30
# EMBED_TIMEOUT_SECONDS=30

# Optional web supplement (Study-logic reads this; vault stays default).
# Unset or down → warning + vault-only fallback. Never required for S0.
# SEARXNG_URL=http://127.0.0.1:8080
